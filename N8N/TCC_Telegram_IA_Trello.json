    {
      "parameters": {
        "jsCode": "const user = $items(\"Code in JavaScript3\")[0].json;\n\nconst trelloMemberId = user.trello_member_id;\nconst trelloName = user.trello_name;\nconst statusFiltro = user.statusFiltro || \"geral\";\n\nconst LISTAS = {\n  a_fazer: \"6a062c534824aa141c9bda4f\",\n  em_andamento: \"6a062c534824aa141c9bda50\",\n  concluido: \"6a062c534824aa141c9bda51\"\n};\n\nconst NOMES = {\n  a_fazer: \"A FAZER\",\n  em_andamento: \"EM ANDAMENTO\",\n  concluido: \"CONCLUÍDO\"\n};\n\nconst cardsDoUsuario = items\n  .map(item => item.json)\n  .filter(card => {\n    return Array.isArray(card.idMembers)\n      && card.idMembers.includes(trelloMemberId)\n      && Object.values(LISTAS).includes(card.idList);\n  });\n\nfunction formatarCards(cards) {\n  if (cards.length === 0) return \"Nenhum card encontrado.\";\n\n  return cards.map((card, index) => {\n    const prazo = card.due\n      ? new Date(card.due).toLocaleDateString(\"pt-BR\")\n      : \"sem prazo\";\n\n    return `${index + 1}. ${card.name}\\nPrazo: ${prazo}`;\n  }).join(\"\\n\\n\");\n}\n\nif (statusFiltro !== \"geral\") {\n  const cardsFiltrados = cardsDoUsuario.filter(card => card.idList === LISTAS[statusFiltro]);\n\n  return [{\n    json: {\n      text: `📋 ${NOMES[statusFiltro]} - ${trelloName}:\\n\\n${formatarCards(cardsFiltrados)}`\n    }\n  }];\n}\n\nconst cardsAFazer = cardsDoUsuario.filter(card => card.idList === LISTAS.a_fazer);\nconst cardsAndamento = cardsDoUsuario.filter(card => card.idList === LISTAS.em_andamento);\nconst cardsConcluido = cardsDoUsuario.filter(card => card.idList === LISTAS.concluido);\n\nreturn [{\n  json: {\n    text:\n`📋 Resumo dos seus passos - ${trelloName}\n\n🟡 A FAZER:\n${formatarCards(cardsAFazer)}\n\n🔵 EM ANDAMENTO:\n${formatarCards(cardsAndamento)}\n\n✅ CONCLUÍDO:\n${formatarCards(cardsConcluido)}`\n  }\n}];"
      },
