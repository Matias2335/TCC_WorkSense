    {
      "parameters": {
        "jsCode": "const textOriginal = $('Telegram Trigger').item.json.message.text.trim();\nconst text = textOriginal.toLowerCase();\n\nconst textSemAcento = text\n  .normalize(\"NFD\")\n  .replace(/[\\u0300-\\u036f]/g, \"\");\n\nlet action = \"ai\";\nlet statusFiltro = \"geral\";\n\nif (\n  textSemAcento.includes(\"minhas tarefas\") ||\n  textSemAcento === \"tarefas do gestor\" ||\n  textSemAcento === \"tarefa principal\"\n) {\n  action = \"listar_tarefas\";\n}\n\nif (\n  textSemAcento.includes(\"listar a fazer\") ||\n  textSemAcento.includes(\"ver a fazer\") ||\n  textSemAcento.includes(\"listar em andamento\") ||\n  textSemAcento.includes(\"ver em andamento\") ||\n  textSemAcento.includes(\"listar concluido\") ||\n  textSemAcento.includes(\"ver concluido\") ||\n  textSemAcento.includes(\"listar geral\") ||\n  textSemAcento.includes(\"meus passos\") ||\n  textSemAcento.includes(\"minhas etapas\")\n) {\n  action = \"listar_execucao\";\n\n  if (textSemAcento.includes(\"a fazer\")) {\n    statusFiltro = \"a_fazer\";\n  }\n\n  if (textSemAcento.includes(\"em andamento\")) {\n    statusFiltro = \"em_andamento\";\n  }\n\n  if (textSemAcento.includes(\"concluido\")) {\n    statusFiltro = \"concluido\";\n  }\n\n  if (\n    textSemAcento.includes(\"geral\") ||\n    textSemAcento.includes(\"meus passos\") ||\n    textSemAcento.includes(\"minhas etapas\")\n  ) {\n    statusFiltro = \"geral\";\n  }\n}\n\nif (\n  textSemAcento === \"criar_passo\" ||\n  textSemAcento === \"criar passo\" ||\n  textSemAcento === \"criar passos\" ||\n  (\n    textSemAcento.includes(\"titulo:\") &&\n    textSemAcento.includes(\"descricao:\")\n  )\n) {\n  action = \"criar_passos\";\n}\n\nif (\n  textSemAcento.startsWith(\"mover\") ||\n  textSemAcento.includes(\"para em andamento\") ||\n  textSemAcento.includes(\"para concluido\") ||\n  textSemAcento.includes(\"para a fazer\")\n) {\n  action = \"mover_card\";\n}\n\nreturn [{\n  json: {\n    ...$json,\n    action,\n    statusFiltro,\n    text: textOriginal\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2016,
