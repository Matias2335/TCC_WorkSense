      ],
      "id": "5db9798d-fef3-4d56-bd10-673dda9b1c36",
      "name": "Code in JavaScript3"
    },
    {
      "parameters": {
        "jsCode": "const user = items[0].json;\nconst text = user.text || $('Telegram Trigger').item.json.message.text.trim();\n\nconst tituloMatch = text.match(/t[ií]tulo:\\s*([\\s\\S]*?)(?=descri[cç][aã]o:|$)/i);\nconst descricaoMatch = text.match(/descri[cç][aã]o:\\s*([\\s\\S]*)/i);\n\nif (!tituloMatch || !descricaoMatch) {\n  return [{\n    json: {\n      error: true,\n      text: \"❌ Use o formato:\\n\\nTítulo: Nome do passo\\nDescrição: Descrição detalhada do que deve ser feito\"\n    }\n  }];\n}\n\nconst titulo = tituloMatch[1].trim();\nconst descricao = descricaoMatch[1].trim();\n\nif (!titulo) {\n  return [{\n    json: {\n      error: true,\n      text: \"❌ O título do passo não pode ficar vazio.\"\n    }\n  }];\n}\n\nif (!descricao || descricao.length < 20) {\n  return [{\n    json: {\n      error: true,\n      text: \"❌ A descrição precisa ser mais detalhada. Explique melhor o que deve ser feito.\"\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    error: false,\n    titulo,\n    descricao: `Responsável: ${user.trello_name}\\n\\nDescrição detalhada:\\n${descricao}`,\n    trello_member_id: user.trello_member_id,\n    trello_name: user.trello_name\n  }\n}];"
      },
