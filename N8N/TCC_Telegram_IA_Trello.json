    {
      "parameters": {
        "jsCode": "const user = $items(\"Code in JavaScript3\")[0].json;\n\nconst textOriginal = user.text || $('Telegram Trigger').item.json.message.text.trim();\nconst text = textOriginal.toLowerCase();\n\nconst LISTAS = {\n  A_FAZER: \"6a062c534824aa141c9bda4f\",\n  EM_ANDAMENTO: \"6a062c534824aa141c9bda50\",\n  CONCLUIDO: \"6a062c534824aa141c9bda51\"\n};\n\nconst NOMES_LISTAS = {\n  A_FAZER: \"A FAZER\",\n  EM_ANDAMENTO: \"EM ANDAMENTO\",\n  CONCLUIDO: \"CONCLUÍDO\"\n};\n\nlet destino = null;\n\nif (text.includes(\"para em andamento\")) {\n  destino = \"EM_ANDAMENTO\";\n}\n\nif (text.includes(\"para concluido\") || text.includes(\"para concluído\")) {\n  destino = \"CONCLUIDO\";\n}\n\nif (text.includes(\"para a fazer\")) {\n  destino = \"A_FAZER\";\n}\n\nif (!destino) {\n  return [{\n    json: {\n      error: true,\n      text: \"❌ Informe o destino correto: a fazer, em andamento ou concluído.\\n\\nExemplo:\\nmover Tela do carrinho para em andamento\"\n    }\n  }];\n}\n\nconst nomeCard = textOriginal\n  .replace(/^mover\\s+/i, \"\")\n  .replace(/\\s+para\\s+em andamento/i, \"\")\n  .replace(/\\s+para\\s+concluido/i, \"\")\n  .replace(/\\s+para\\s+concluído/i, \"\")\n  .replace(/\\s+para\\s+a fazer/i, \"\")\n  .trim();\n\nif (!nomeCard) {\n  return [{\n    json: {\n      error: true,\n      text: \"❌ Informe o nome do card.\\n\\nExemplo:\\nmover Tela do carrinho para em andamento\"\n    }\n  }];\n}\n\nconst listasPermitidas = Object.values(LISTAS);\n\nconst cardsDoUsuario = items\n  .map(item => item.json)\n  .filter(card => {\n    return Array.isArray(card.idMembers)\n      && card.idMembers.includes(user.trello_member_id)\n      && listasPermitidas.includes(card.idList);\n  });\n\nconst card = cardsDoUsuario.find(c =>\n  c.name.toLowerCase().includes(nomeCard.toLowerCase())\n);\n\nif (!card) {\n  const disponiveis = cardsDoUsuario.length\n    ? cardsDoUsuario.map(c => `- ${c.name}`).join(\"\\n\")\n    : \"Nenhum card encontrado em A FAZER, EM ANDAMENTO ou CONCLUÍDO.\";\n\n  return [{\n    json: {\n      error: true,\n      text: `❌ Não encontrei esse card nas suas tarefas.\\n\\nCards disponíveis:\\n${disponiveis}`\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    error: false,\n    card_id: card.id,\n    card_name: card.name,\n    idList: LISTAS[destino],\n    destino_label: NOMES_LISTAS[destino]\n  }\n}];"
      },
