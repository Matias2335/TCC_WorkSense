    {
      "parameters": {
        "jsCode": "const user = $items(\"Code in JavaScript3\")[0].json;\n\nconst trelloMemberId = user.trello_member_id;\nconst trelloName = user.trello_name;\n\nif (!trelloMemberId) {\n  return [{\n    json: {\n      text: \"❌ Não encontrei seu ID de membro do Trello no cadastro. Verifique o banco de dados.\"\n    }\n  }];\n}\n\nconst cards = items\n  .map(item => item.json)\n  .filter(card => {\n    return Array.isArray(card.idMembers) && card.idMembers.includes(trelloMemberId);\n  });\n\nif (cards.length === 0) {\n  return [{\n    json: {\n      text: `Você não possui tarefas atribuídas na lista TAREFAS no momento.`\n    }\n  }];\n}\n\nconst texto = cards.map((card, index) => {\n  const prazo = card.due\n    ? new Date(card.due).toLocaleDateString(\"pt-BR\")\n    : \"sem prazo\";\n\n  return `${index + 1}. ${card.name}\\nPrazo: ${prazo}`;\n}).join(\"\\n\\n\");\n\nreturn [{\n  json: {\n    text: `📋 Tarefas atribuídas a ${trelloName}:\\n\\n${texto}`\n  }\n}];"
      },
